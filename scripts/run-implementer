#!/usr/bin/env bash
#
# Runs one implementer, in a terminal of its own.
#
#     scripts/run-implementer Cyclops
#     scripts/run-implementer Cyclops --log     # keep every event in .claude/implementers/<name>.log
#
# The name must be an X-Man from the roster in `runImplementer.ts`, spelt exactly as it appears
# there. Anything else exits 2 and prints the list. The roster is closed because Cerebro works from
# it: an implementer it never looks for would hold a bead and open PRs unaccounted for.
#
# This is a wrapper and nothing more. **The loop is in `scripts/runImplementer.ts`** — go there to
# read or debug it; all this file does is run it with the workspace's own tsx.
#
# What that loop does: each bead gets a fresh `claude` process, which exits when the bead is merged;
# the loop then re-reads the flags and starts another. So "one bead per process" is a property of
# how an implementer is run instead of a rule it has to keep, and context cannot grow across beads.
#
# Cerebro drives it with two files:
#
#     .claude/implementers/<name>.go      present: keep taking beads
#     .claude/implementers/<name>.stop    present: finish the current bead, then leave
#
# Neither is read mid-bead. Taking an implementer down means telling it to finish: a bead abandoned
# in flight strands a claim, a worktree and an open PR for somebody to unpick by hand.
#
# The work streams past this terminal as it happens. `--log` also keeps it, which is what Cerebro
# reads when it needs to know what an implementer is doing - but one bead is about a megabyte and the
# file is appended across runs, so it is off unless asked for.
#
# Leave the terminal open when it idles. Idle costs nothing, and it means putting this implementer
# back to work is one `touch` rather than another launch.

set -euo pipefail

# `pnpm exec`, not `npx`: it runs the tsx this workspace already depends on, where npx will happily
# fetch a version from the registry when node_modules is not installed yet - a network fetch nobody
# asked for, and a different tsx from the one every other script here runs under.
exec pnpm exec tsx "$(dirname "${BASH_SOURCE[0]}")/runImplementer.ts" "$@"
