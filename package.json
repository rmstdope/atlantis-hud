{
  "name": "atlantis-hud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck && cargo check --workspace",
    "test": "pnpm -r run test && cargo test --workspace",
    "test:smoke": "playwright test",
    "check": "pnpm run ruleset:sync && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:smoke && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings",
    "ruleset:sync": "node -e \"const {copyFileSync,mkdirSync}=require('fs');for(const a of ['web','desktop']){mkdirSync('apps/'+a+'/public',{recursive:true});copyFileSync('config/ruleset.json','apps/'+a+'/public/ruleset.json')}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
