{
  "name": "@atlantis/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "pnpm --filter @atlantis/browser-core build:wasm",
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@atlantis/browser-core": "workspace:*",
    "@atlantis/core-client": "workspace:*",
    "@atlantis/shared": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
