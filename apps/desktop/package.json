{
  "name": "@atlantis/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-deps.mjs && node ../../scripts/ensure-wasm.mjs && vite --port 4184 --strictPort",
    "build": "node ../../scripts/ensure-deps.mjs && pnpm run build:wasm && vite build",
    "preview": "vite preview --port 4174",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "logs:export": "node scripts/export-logs.mjs",
    "build:wasm": "pnpm --filter @atlantis/browser-core build:wasm"
  },
  "dependencies": {
    "@atlantis/browser-core": "workspace:*",
    "@atlantis/core-client": "workspace:*",
    "@atlantis/shared": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.4.0"
  }
}
