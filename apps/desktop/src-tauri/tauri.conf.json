{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlantis HUD",
  "version": "0.14.0",
  "identifier": "com.atlantis.hud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4174",
    "beforeDevCommand": "pnpm --filter @atlantis/desktop dev",
    "beforeBuildCommand": "pnpm --filter @atlantis/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Atlantis HUD Desktop Shell",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A heads-up display for the play-by-email game Atlantis.",
    "longDescription": "Atlantis HUD reads a turn report, draws the map it describes, and helps write next turn's orders.",
    "copyright": "MIT licensed. See LICENSE.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
