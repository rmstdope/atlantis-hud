{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlantis HUD",
  "version": "0.1.0",
  "identifier": "com.atlantis.hud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4174",
    "beforeDevCommand": "pnpm --filter @atlantis/desktop dev",
    "beforeBuildCommand": "pnpm --filter @atlantis/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Atlantis HUD Desktop Shell",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
