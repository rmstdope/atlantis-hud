# Emacs
*~

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo
playwright-report/
test-results/

# Logs and local app data
*.log
apps/desktop/.logs/

# Rust
target/
apps/desktop/src-tauri/gen/

# Generated by wasm-pack; rebuild with pnpm --filter @atlantis/web build:wasm
packages/browser-core/src/wasm/

# Local env files
.env
.env.*

# Local temp files
.tmp/

# Local agent scratch space; never part of the project, except the project-wide agent
# configuration: the repository's skills, its agent definitions, and the shared settings (beads
# session hook).
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/cerebro

# Cerebro's own directory in a consumer. Three things the fleet writes while it runs are ignored:
# the agents' worktrees, their state files and stop flags, and the planners' scratchpad, the drafts
# and rejected mockup variants `skills/plan-bead` writes before a plan reaches the bead. Everything
# else in it is tracked - the project's declarations (project.conf, roster.conf, traps.md; cb-epr)
# and agents.conf, which this project commits so every clone runs the fleet on the same tools and
# models (cb-94y.2). A project that wants agents.conf personal adds `.cerebro/agents.conf` here. A
# new runtime artifact must be added to this list, or it arrives committable: that is the trade for
# committing agents.conf.
.cerebro/worktrees
.cerebro/state
.cerebro/scratch

# Games live in the platform application data directory, never in the repository. This is a
# backstop against a stray relative path putting one here again, as one did before issue #33.
apps/desktop/src-tauri/atlantis-hud/
*.sqlite

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# MacOS
.DS_Store
