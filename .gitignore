# Emacs
*~

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo
playwright-report/
test-results/

# Logs and local app data
*.log
apps/desktop/.logs/

# Rust
target/
apps/desktop/src-tauri/gen/

# Generated by wasm-pack; rebuild with pnpm --filter @atlantis/web build:wasm
packages/browser-core/src/wasm/

# Local env files
.env
.env.*

# Local temp files
.tmp/

# Local agent scratch space; never part of the project, except the project-wide agent
# configuration: the repository's skills, its agent definitions, and the shared settings (beads
# session hook).
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/cerebro

# Cerebro's own bookkeeping - agent state files, stop flags and the agents' worktrees. Live
# machine state, never part of the project (ah-v82).
.cerebro/

# Games live in the platform application data directory, never in the repository. This is a
# backstop against a stray relative path putting one here again, as one did before issue #33.
apps/desktop/src-tauri/atlantis-hud/
*.sqlite

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# MacOS
.DS_Store
